# 1. Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# 2. (Optional) Which Gemini model to use
GEMINI_MODEL=gemini-flash-latest

# 3. (Optional) Use an existing wallet for the agent (private key, 0x...).
#    Leave empty and use the "Create wallet" button on the page instead.
#    Use a TEST wallet only. Never put a wallet with real money here.
WALLET_PRIVATE_KEY=

# ─── Week 3: x402 payments (Base Sepolia TESTNET ONLY) ───
# 1 = provider routes refuse unpaid calls with a real x402 402.
PAYWALL=0
# 1 = the Foreman freezes: no commission, no tips (checked in tool code).
KILL_SWITCH=0
# Provider settlement wallet (x402 settle + tip sink). Leave unset and call the
# create_provider_wallet tool once to generate .provider-wallet.json (gitignored).
PROVIDER_PRIVATE_KEY=
# Optional: force all tips/x402 payTo to a single address.
PROVIDER_PAY_TO_OVERRIDE=

[TEMPLATE]
# ─── LLM provider ───
# gemini = Google Gemini (original path), groq = Groq (OpenAI-compatible, fast
# and cheap). If the chosen provider has no key, the other one is used when
# possible; set STRICT_PROVIDER=1 to make that a hard error instead.
LLM_PROVIDER=gemini
# 1 = never silently switch providers when the selected one has no key.
STRICT_PROVIDER=

# 1. Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# 2. (Optional) Which Gemini model to use
GEMINI_MODEL=gemini-flash-latest

# 3. (Optional) Groq — used when LLM_PROVIDER=groq. Get a key at console.groq.com/keys
#    Free tier is enough for the demo. Groq rotates its model lineup, so if a
#    model 404s, list what your key can reach and pick from that:
#    curl -H "Authorization: Bearer $GROQ_API_KEY" https://api.groq.com/openai/v1/models
#    (Current tool-capable chat models: openai/gpt-oss-120b, openai/gpt-oss-20b,
#     qwen/qwen3.8-27b. The llama-3.3/3.1 IDs have been retired.)
GROQ_API_KEY=
# Primary model = the Foreman's tool-calling loop.
GROQ_MODEL=openai/gpt-oss-120b
# Cheap model = persona + judge calls, and the automatic fallback when the
# primary 429s. Groq meters each model separately on the free tier, so this
# model has its OWN 1,000 req/day and 200K tokens/day quota.
GROQ_CHEAP_MODEL=openai/gpt-oss-20b
# (Optional) Override the Groq API origin — for local mocks/tests only.
# GROQ_BASE_URL=http://127.0.0.1:PORT

# 3. (Optional) Use an existing wallet for the agent (private key, 0x...).
#    Leave empty and use the "Create wallet" button on the page instead.
#    Use a TEST wallet only. Never put a wallet with real money here.
WALLET_PRIVATE_KEY=

# ─── Week 3: x402 payments (Base Sepolia TESTNET ONLY) ───
# 1 = provider routes refuse unpaid calls with a real x402 402.
PAYWALL=0
# 1 = the Foreman freezes: no commission, no tips (checked in tool code).
KILL_SWITCH=0
# Provider settlement wallet (x402 settle + tip sink). Leave unset and call the
# create_provider_wallet tool once to generate .provider-wallet.json (gitignored).
PROVIDER_PRIVATE_KEY=
# Optional: force all tips/x402 payTo to a single address.
PROVIDER_PAY_TO_OVERRIDE=

# ─── Week 2: natural-language transfers (Base Sepolia TESTNET ONLY) ───
# Per-transfer ceiling for a user-initiated transfer.
MAX_TRANSFER_USDC=100
# Rolling 24h ceiling across ALL user-initiated transfers.
MAX_DAILY_TRANSFER_USDC=500
# Gas-sponsoring facilitator used to settle USDC (relays the tx and pays gas,
# so the agent wallet needs zero ETH). Override for a self-hosted facilitator.
X402_FACILITATOR_URL=https://x402.org/facilitator

# ─── Week 2 (advanced): the NFT contract (Base Sepolia TESTNET ONLY) ───
# The host the tokenURI points at. Set it to the public URL of the deployed
# app, or the tokenURI will point at localhost.
APP_URL=http://localhost:3000
# Per-purchase ceiling for an NFT the agent buys for itself.
MAX_NFT_PRICE_USDC=0.25
# The deployed UselessNFT address. `npm run deploy:nft` writes it to
# .nft-contract.json (gitignored) and the app reads that file, so this is only
# needed to point at a contract deployed some other way.
NFT_CONTRACT_ADDRESS=
# Point the NFT desk at another chain. Used by the local-EVM tests
# (npm run test:nft-app); leave unset for Base Sepolia.
NFT_RPC_URL=
NFT_CHAIN_ID=
